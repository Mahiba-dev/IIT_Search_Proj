# Server config. No provider API keys are set here — each request carries
# its own key via the Authorization header from the client, scoped to the
# provider the user selected in the sidebar. Keys are never persisted or
# logged by the backend.

ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=20
MAX_QUERY_LENGTH=2000
OPENAI_TIMEOUT_SECONDS=30
